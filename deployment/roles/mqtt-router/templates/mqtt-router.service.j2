[Unit]
Description=mqtt-router
Documentation=https://github.com/suhlig/mqtt-disarm
After=network-online.target

[Service]
ExecStart={{ app_dir }}/bin/mqtt-router \
            --mqtt {{ mqtt_router_mqtt_url }} \
            --blink1-topic {{ mqtt_router_blink1_topic }} \
            --verbose \
            --verbose \
            --verbose \
            --verbose
Type=simple
Restart=on-failure
# TODO User=mqtt-disarm
# TODO Group=mqtt-disarm

[Install]
WantedBy=default.target
Alias=mqtt-router.service
