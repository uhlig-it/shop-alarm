[Unit]
Description=mqtt-blink1
Documentation=https://github.com/uhlig-it/shop-alarm
After=network-online.target

[Service]
WorkingDirectory={{ ansistrano_release_path.stdout }}
ExecStart={{ ansistrano_release_path.stdout }}/bin/mqtt-blink1 \
            --mqtt {{ shopalarm_mqtt_url }} \
            --command-topic {{ blink1_mqtt_command_topic }} \
            --status-topic {{ blink1_mqtt_status_topic }} \
            --verbose \
            --verbose
Type=simple
Restart=on-failure

[Install]
WantedBy=default.target
Alias=mqtt-blink1.service
