#!/usr/bin/env ruby

require 'rubygems'
require 'bundler/setup'

require 'optparse'
require 'logger'
require 'pathname'
require 'mqtt'

require_relative '../lib/mqtt/motion'

options = {
  mqtt: {
    url: nil,
    topic: nil,
  },
  motion: {
    url: 'http://localhost:8080',
    camera_id: 0,
  },
}

blink1 = ::Blink1.new

logger = Logger.new(STDERR)
logger.level = Logger::FATAL
logger.progname = Pathname(__FILE__).basename

OptionParser.new do |opts|
  opts.banner = <<~EOM
    Interprets domain events as they appear on MQTT and transforms some of them into Blink1 patterns.

    Options:
  EOM
  opts.version = '1.0.0'

  opts.on('-v', '--verbose', 'Run verbosely. Repeat for even more verbosity.') do
    logger.level = logger.level - 1 if logger.level > 0
  end

  opts.on('--mqtt=MQTT_URI', 'The URI to the MQTT server') do |mqtt|
    options[:mqtt][:url] = mqtt
  end

  opts.on('--topic=TOPIC', 'The MQTT topic where the events are expected') do |topic|
    options[:mqtt][:topic] = topic
  end

  opts.on('--motion=MOTION_URI', 'The URI to the Motion web control interface') do |url|
    options[:motion][:url] = url
  end
end.parse!

begin
  logger.info "Log level is #{%w[DEBUG INFO WARN ERROR FATAL UNKNOWN][logger.level]}"
  blink1.open

  MQTT::Motion.new(
    broker: MQTT::Client.connect(options[:mqtt][:url]),
    topic: options[:mqtt][:topic],
    motion: MQTT::Motion.new(options[:motion][:url], options[:motion][:camera_id]),
    logger: logger
  ).start!
rescue MQTT::ProtocolException => err
  logger.error err.backtrace.join("\n")
  retry
rescue => err
  warn "Error: #{err}"
  logger.error(err)
  logger.error err.backtrace.join("\n")
  exit 1
ensure
  blink1.close
end
