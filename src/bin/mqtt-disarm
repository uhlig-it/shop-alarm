#!/usr/bin/env ruby

require 'rubygems'
require 'bundler/setup'

require 'optparse'
require 'logger'
require 'pathname'
require 'mqtt'

require_relative '../lib/mqtt/alarm'
require_relative '../lib/motion/web_controller'

options = {
  mqtt: {
    url: nil,
  },
  motion: {
    url: 'http://localhost:8080',
    camera_id: 0,
  },
  status_topic: nil,
  keyboard_topic: nil,
  code: nil,
}

logger = Logger.new(STDERR)
logger.level = Logger::FATAL
logger.progname = Pathname(__FILE__).basename

OptionParser.new do |opts|
  opts.banner = <<~EOM
    Subscribes an MQTT topic and, if the right message appears, disarms the alarm system.

    Options:
  EOM
  opts.version = '1.0.0'

  opts.on('-v', '--verbose', 'Run verbosely. Repeat for even more verbosity.') do
    logger.level = logger.level - 1 if logger.level > 0
  end

  opts.on('--mqtt=MQTT_URI', 'The URI to the MQTT server') do |mqtt|
    options[:mqtt][:url] = mqtt
  end

  opts.on('--motion=MOTION_URI', 'The URI to the Motion web control interface') do |url|
    options[:motion][:url] = url
  end

  opts.on('--keyboard-topic=TOPIC', 'The MQTT topic where the arm / disarm message is expected') do |topic|
    options[:keyboard_topic] = topic
  end

  opts.on('--status-topic=TOPIC', 'The MQTT topic where the new status of the alarm is published to') do |topic|
    options[:status_topic] = topic
  end

  opts.on('--pir-topic=TOPIC', 'The MQTT topic where the PIR sensor status is published to') do |topic|
    options[:pir_topic] = topic
  end

  opts.on('--code=CODE', 'The secret code to disarm the alarm system') do |code|
    options[:code] = code
  end
end.parse!

begin
  logger.info "Log level is #{%w[DEBUG INFO WARN ERROR FATAL UNKNOWN][logger.level]}"
  logger.debug "Alarm will be disarmed when code #{options[:code]} was received"

  MQTT::Alarm.new(
    broker: MQTT::Client.connect(options[:mqtt][:url]),
    motion: Motion::WebController.new(options[:motion][:url], options[:motion][:camera_id]),
    keyboard_topic: options[:keyboard_topic],
    status_topic: options[:status_topic],
    pir_topic: options[:pir_topic],
    logger: logger
  ).start!(options[:code])
rescue MQTT::ProtocolException => err
  logger.error err.backtrace.join("\n")
  retry
rescue => err
  warn "Error: #{err}"
  logger.error(err)
  logger.error err.backtrace.join("\n")
  exit 1
end
