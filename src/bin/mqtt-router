#!/usr/bin/env ruby

require 'rubygems'
require 'bundler/setup'

require 'optparse'
require 'logger'
require 'pathname'
require 'mqtt'

require_relative '../lib/mqtt/router'

options = {
  mqtt: {
    url: nil,
  },
  status_topic: nil,
  blink1_topic: nil,
}

logger = Logger.new(STDERR)
logger.level = Logger::FATAL
logger.progname = Pathname(__FILE__).basename

OptionParser.new do |opts|
  opts.banner = <<~EOM
    Subscribes an MQTT topic and translates messages into Blink1 patterns

    Options:
  EOM
  opts.version = '1.0.0'

  opts.on('-v', '--verbose', 'Run verbosely. Repeat for even more verbosity.') do
    logger.level = logger.level - 1 if logger.level > 0
  end

  opts.on('--mqtt=MQTT_URI', 'The URI to the MQTT server') do |mqtt|
    options[:mqtt][:url] = mqtt
  end

  opts.on('--blink1-topic=TOPIC', 'The MQTT topic where the blink1 message is published to') do |topic|
    options[:blink1_topic] = topic
  end

  opts.on('--status-topic=TOPIC', 'The MQTT topic where the new status of the alarm is published to') do |topic|
    options[:status_topic] = topic
  end
end.parse!

begin
  logger.info "Log level is #{%w[DEBUG INFO WARN ERROR FATAL UNKNOWN][logger.level]}"

  broker = MQTT::Client.connect(options[:mqtt][:url])
  router = MQTT::Router.new(broker: broker, logger: logger)
  blink1 = MQTT::Blink1::Client.new(broker: broker, topic: options[:blink1_topic], logger: logger)

  router.add_route(options[:status_topic]) do |topic, message|
    case message
    when 'disarmed'
      blink1.color(red: 0, green: 128, blue: 0)
    when 'armed'
      blink1.color(red: 128, green: 0, blue: 0)
    when 'tampered'
      blink1.blink(count: 3, red: 255, green: 255, blue: 0)
    end
  end

  router.start!
rescue MQTT::ProtocolException => err
  logger.error err.backtrace.join("\n")
  retry
rescue => err
  warn "Error: #{err}"
  logger.error(err)
  logger.error err.backtrace.join("\n")
  exit 1
end
