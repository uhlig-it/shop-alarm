#!/usr/bin/env python3

# Prereqs:
# * sudo apt install python3-gpiozero python3-pip
# * pip3 install paho-mqtt

# TODO
# * --verbose

from gpiozero import MotionSensor
from signal import pause
import argparse
from urllib.parse import urlparse
import paho.mqtt.client as mqtt
import logging

parser = argparse.ArgumentParser(description='Publishes PIR events to MQTT')
parser.add_argument("--mqtt", dest="mqtt", help="URL of the MQTT broker", metavar="MQTT")
parser.add_argument("--topic", dest="topic", help="MQTT topic where the PIR status is published to", metavar="TOPIC")
parser.add_argument("--gpio", dest="gpio", help="GPIO port where the PIR sensor is connected to", metavar="GPIO")
parser.add_argument("--verbose", action = "count", default = 0, help = "Verbose logging. Repeat to increase verbosity.")
args = parser.parse_args()

pir = MotionSensor(args.gpio)
broker = mqtt.Client()

try:
    loglevel = {
        0: logging.ERROR,
        1: logging.WARN,
        2: logging.INFO}[args.verbose]
except KeyError:
    loglevel = logging.DEBUG
logging.basicConfig(level = loglevel, format='%(asctime)s %(levelname)s %(message)s', datefmt='%Y-%m-%d %H:%M:%S')
logging.getLogger().setLevel(loglevel)

def on_motion_begin():
    broker.publish(args.topic, "begin")
    logging.info('motion begin')

def on_motion_end():
    broker.publish(args.topic, "end")
    logging.info('motion end')

def on_connect(client, userdata, flags, rc):
    logging.info("MQTT connected with result code "+str(rc))

def on_disconnect(client, userdata, rc):
    logging.info("MQTT disconnected with result code "+str(rc))

def on_publish(client, userdata, mid):
    logging.debug("Message successfully published with mid = " + str(mid))

mqtt = urlparse(args.mqtt)

broker.on_connect = on_connect
broker.on_disconnect = on_disconnect
broker.on_publish = on_publish
broker.enable_logger(logging)
broker.username_pw_set(mqtt.username, mqtt.password)

if mqtt.scheme == "mqtts":
    broker.tls_set_context()

broker.connect(mqtt.hostname, mqtt.port or 8883, 10)

pir.when_motion = on_motion_begin
pir.when_no_motion = on_motion_end

logging.info("Let's go.")
broker.loop_forever()
